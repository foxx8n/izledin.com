# ==============================================================================
# izledin.com - Environment Configuration
# ==============================================================================

# Supabase (Auth, Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OMDB (Open Movie Database) API Key (Server-Only Secret)
OMDB_API_KEY=your_omdb_api_key

# Site URL
# NOTE: Reserved/unused — hardcoded 'https://izledin.com' is used in layout.tsx,
# sitemap.ts and robots.ts. Keep in sync manually if the domain ever changes.
NEXT_PUBLIC_SITE_URL=https://izledin.com

# Resend (Transactional Email) — REQUIRED for /api/contact to work.
# Without it the contact endpoint responds 503.
RESEND_API_KEY=

# Upstash Redis (Distributed Rate Limiting) — OPTIONAL.
# Without these, rate limiting falls back gracefully to per-instance in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
